# Copy this to .env and fill in your values

# Claude API key — required for Option A (real generation)
# Leave blank to force DEMO_MODE=true
ANTHROPIC_API_KEY=

# Set to true to skip Claude API generation and use the pre-built collateral
# files from the project root (out_faq.md, out_fae_checklist.md).
# Extraction, verification, and DOCX render still run for real in demo mode.
DEMO_MODE=true

# Absolute path to the allegro-launch-kit project root
# Default: two levels up from this file
PROJECT_ROOT=

# Where to store per-job working files
JOB_DIR=./tmp/jobs

# Port for the FastAPI server
PORT=8000
